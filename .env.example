# Copy to .env and fill in values (never commit .env)
# bthinkx.com mail is on Zoho (not Gmail). Use hr@ account password or Zoho app password.
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=hr@bthinkx.com
EMAIL_HOST_PASSWORD=your-zoho-password-here
DEFAULT_FROM_EMAIL=hr@bthinkx.com
BILLING_FROM_EMAIL=hr@bthinkx.com
CONTACT_EMAIL_TO=hr@bthinkx.com

# WhatsApp Web.js integration (Node gateway)
WHATSAPP_TRANSPORT=webjs
WHATSAPP_WEBJS_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_WEBJS_BRIDGE_TOKEN=change-me-too

# Node -> Django auth token (Bearer)
DJANGO_API_TOKEN=change-me

# Gemini AI sales qualification on WhatsApp
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AI_QUALIFICATION_ENABLED=true
GEMINI_MAX_HISTORY_MESSAGES=10

# Voice notes: false = Gemini transcribes (recommended). true = local faster-whisper (downloads ~500MB from HF Hub).
WHISPER_LOCAL_ENABLED=false
WHISPER_MODEL_SIZE=small
# Optional Hugging Face token if WHISPER_LOCAL_ENABLED=true (higher rate limits)
# HF_TOKEN=

# Reply buttons are deprecated by WhatsApp — leave false (use numbered text menus)
WHATSAPP_USE_REPLY_BUTTONS=false
