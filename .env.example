# Copy to .env and fill in values (never commit .env)
# bthinkx.com mail is on Zoho (not Gmail). Use hr@ account password or Zoho app password.
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=hr@bthinkx.com
EMAIL_HOST_PASSWORD=your-zoho-password-here
DEFAULT_FROM_EMAIL=hr@bthinkx.com
CONTACT_EMAIL_TO=hr@bthinkx.com

# Google Analytics 4 — public site (templates/pages/) only. Leave unset on local/dev
# machines so test traffic doesn't pollute real analytics; set only in production.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cashfree Payment Gateway — public offer landing pages (e.g. /offers/navaratri/).
# CASHFREE_ENV=sandbox uses test credentials/sandbox.cashfree.com; production uses
# live credentials/api.cashfree.com. Get keys from the Cashfree merchant dashboard.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---------------------------------------------------------------------------
# BThinkX Business OS (/crm/) — see docs/crm/DEPLOYMENT.md
# Production values are commented out so a local copy keeps SQLite and debug mode.
# ---------------------------------------------------------------------------
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=erp.example.com
# CSRF_TRUSTED_ORIGINS=https://erp.example.com

# Web Push (PWA notifications). Generate once per project with:
#   python manage.py crm_generate_vapid_keys
# then copy the same pair into every environment — a new keypair invalidates
# every device's existing push subscription (they will need to re-enable).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=mailto:hr@bthinkx.com

# PostgreSQL is the production database (SQLite is for local development only).
# DB_ENGINE=postgres
DB_NAME=bthinkx
DB_USER=bthinkx_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Encrypts payment-gateway secrets at rest. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRM_ENCRYPTION_KEY=
# Private documents (invoices, payslips, uploads). Outside the web root; back up with the database.
# CRM_PRIVATE_MEDIA_ROOT=/srv/btx_dev/private_media
CRM_MAX_UPLOAD_MB=10

# Optional: cache, rate limiting and Celery.
REDIS_URL=
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Website chatbot ("Bee") and the CRM AI sales analyst: FREE AI, no card needed.
# 1) Sign up at https://console.groq.com  2) API Keys -> Create key  3) paste it below.
# Without a key both still work in a simpler built-in mode (no AI wording, fixed answers).
# ---------------------------------------------------------------------------
CHATBOT_API_KEY=
# Optional (defaults shown): any OpenAI-compatible provider works.
# CHATBOT_BASE_URL=https://api.groq.com/openai/v1
# CHATBOT_MODEL=llama-3.3-70b-versatile
# CHATBOT_FALLBACK_MODEL=llama-3.1-8b-instant
# CHATBOT_DAILY_AI_LIMIT=900
# CHATBOT_WHATSAPP_NUMBER=917736094292
