# Copy to .env and fill in values (never commit .env)
# bthinkx.com mail is on Zoho (not Gmail). Use hr@ account password or Zoho app password.
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=hr@bthinkx.com
EMAIL_HOST_PASSWORD=your-zoho-password-here
DEFAULT_FROM_EMAIL=hr@bthinkx.com
CONTACT_EMAIL_TO=hr@bthinkx.com

# Google Analytics 4 — public site (templates/pages/) only. Leave unset on local/dev
# machines so test traffic doesn't pollute real analytics; set only in production.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cashfree Payment Gateway — public offer landing pages (e.g. /offers/navaratri/).
# CASHFREE_ENV=sandbox uses test credentials/sandbox.cashfree.com; production uses
# live credentials/api.cashfree.com. Get keys from the Cashfree merchant dashboard.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
