PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated list of whatsapp-web.js LocalAuth clientIds (one per executive)
WA_SESSIONS=admin1,admin2,admin3

# Django integration
DJANGO_API_URL=http://127.0.0.1:8000
DJANGO_API_TOKEN=change-me

# This token secures Django -> Node transport endpoint (/api/whatsapp/send)
# Must match Django setting WHATSAPP_WEBJS_BRIDGE_TOKEN (or set same value for both)
WHATSAPP_WEBJS_BRIDGE_TOKEN=change-me-too

# Human takeover cooldown in minutes (bot pauses when exec manually chats from phone)
HUMAN_TAKEOVER_COOLDOWN_MINUTES=30

# Anti-spam / typing simulation
SEND_MIN_DELAY_MS=1200
SEND_MAX_DELAY_MS=3500
SEND_QUEUE_CONCURRENCY=1

# Media download limits (bytes)
MEDIA_MAX_BYTES=10485760

# QR rendering in terminal (set true to reduce QR size)
QR_SMALL=false
# Disable terminal QR printing (use /qr links instead)
QR_IN_TERMINAL=false

# Puppeteer stability (Windows)
WA_HEADLESS=true
# If you get "Execution context was destroyed", set this to your installed Chrome path, e.g.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

